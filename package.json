{
  "name": "substrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:frontend": "cd frontend && npx vite build --watch --outDir ../public",
    "dev:worker": "npx wrangler dev",
    "dev": "npm run build:frontend && npx wrangler dev",
    "build:frontend": "cd frontend && npm install && npx vite build --outDir ../public",
    "build": "npm run build:frontend",
    "deploy": "npm run build && npx wrangler deploy",
    "db:migrate": "node migrations/run.js"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "zod": "^3.24.0",
    "@hono/zod-validator": "^0.4.3",
    "@neondatabase/serverless": "^0.10.0",
    "resend": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250310.0",
    "wrangler": "^3.113.0",
    "typescript": "^5.7.0"
  }
}
